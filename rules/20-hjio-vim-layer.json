{
  "id": "hjio-vim-layer",
  "placement": "append",
  "legacy_descriptions": [
    "Semicolon VIM layer — hjio arrows with native modifier propagation"
  ],
  "rule": {
    "description": "eezaatee · Semicolon layer: hold ; for hjio arrows (h ← j ↓ i ↑ o →)",
    "manipulators": [
      {
        "description": "; (hold) → activate vim_layer / (tap) → ;",
        "type": "basic",
        "from": {
          "key_code": "semicolon",
          "modifiers": {
            "optional": [
              "any"
            ]
          }
        },
        "to": [
          {
            "set_variable": {
              "name": "vim_layer",
              "value": 1
            }
          }
        ],
        "to_after_key_up": [
          {
            "set_variable": {
              "name": "vim_layer",
              "value": 0
            }
          }
        ],
        "to_if_alone": [
          {
            "key_code": "semicolon"
          }
        ],
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 500
        }
      },
      {
        "description": "h → left_arrow while vim_layer is active; preserve physical modifiers",
        "type": "basic",
        "conditions": [
          {
            "type": "variable_if",
            "name": "vim_layer",
            "value": 1
          }
        ],
        "from": {
          "key_code": "h",
          "modifiers": {
            "optional": [
              "any"
            ]
          }
        },
        "to": [
          {
            "key_code": "left_arrow"
          }
        ]
      },
      {
        "description": "j → down_arrow while vim_layer is active; preserve physical modifiers",
        "type": "basic",
        "conditions": [
          {
            "type": "variable_if",
            "name": "vim_layer",
            "value": 1
          }
        ],
        "from": {
          "key_code": "j",
          "modifiers": {
            "optional": [
              "any"
            ]
          }
        },
        "to": [
          {
            "key_code": "down_arrow"
          }
        ]
      },
      {
        "description": "i → up_arrow while vim_layer is active; preserve physical modifiers",
        "type": "basic",
        "conditions": [
          {
            "type": "variable_if",
            "name": "vim_layer",
            "value": 1
          }
        ],
        "from": {
          "key_code": "i",
          "modifiers": {
            "optional": [
              "any"
            ]
          }
        },
        "to": [
          {
            "key_code": "up_arrow"
          }
        ]
      },
      {
        "description": "o → right_arrow while vim_layer is active; preserve physical modifiers",
        "type": "basic",
        "conditions": [
          {
            "type": "variable_if",
            "name": "vim_layer",
            "value": 1
          }
        ],
        "from": {
          "key_code": "o",
          "modifiers": {
            "optional": [
              "any"
            ]
          }
        },
        "to": [
          {
            "key_code": "right_arrow"
          }
        ]
      }
    ]
  }
}
